{
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "bun \"${CLAUDE_PLUGIN_ROOT}/bin/axos.ts\" hook start", "timeout": 10 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "bun \"${CLAUDE_PLUGIN_ROOT}/bin/axos.ts\" hook prompt", "timeout": 10 }] }],
    "PostToolUse": [{ "hooks": [{ "type": "command", "command": "bun \"${CLAUDE_PLUGIN_ROOT}/bin/axos.ts\" hook tool", "timeout": 10 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "bun \"${CLAUDE_PLUGIN_ROOT}/bin/axos.ts\" hook stop", "timeout": 10 }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "bun \"${CLAUDE_PLUGIN_ROOT}/bin/axos.ts\" hook end", "timeout": 5 }] }]
  }
}
