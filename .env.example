# The public name of your hub. DNS for it must point at this machine; Caddy gets the certificate.
AXOS_DOMAIN=axos.example.com

# Optional: phone pushes through ntfy (https://ntfy.sh or your own server). Without it, questions to you
# still appear on your AXOS page. The topic per person is set with: axos human ntfy <name> <topic>
# AXOS_NTFY_URL=https://ntfy.sh
# AXOS_NTFY_TOKEN=
